{% set deps = ['network-online.target'] %}
{% if secretweb_wants_openvpn_server %}{% set _ = deps.append('openvpn-server.service') %}{% endif %}
{% if secretweb_wants_openvpn_client %}{% set _ = deps.append('openvpn-client.service') %}{% endif %}
[Unit]
Description=secretweb ({{ secretweb_env }})
After={{ deps | join(' ') }}
Wants={{ deps | join(' ') }}

[Service]
Type=oneshot
RemainAfterExit=yes
User={{ secretweb_user }}
WorkingDirectory={{ secretweb_install_dir }}
{% if secretweb_wants_openvpn_server or secretweb_wants_openvpn_client %}
# openvpn-server.service/openvpn-client.service being "started" doesn't
# guarantee the tunnel interface is actually up/routable yet - a fixed
# buffer is a blunt but simple mitigation.
ExecStartPre=/bin/sleep 5
{% endif %}
ExecStart={{ secretweb_install_dir }}/venv/bin/python {{ secretweb_install_dir }}/initiator.py --basedir {{ secretweb_install_dir }}
ExecStop={{ secretweb_install_dir }}/venv/bin/python {{ secretweb_install_dir }}/initiator.py --stop --basedir {{ secretweb_install_dir }}

[Install]
WantedBy=multi-user.target
