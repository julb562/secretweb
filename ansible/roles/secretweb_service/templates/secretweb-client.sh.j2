#!/bin/sh
# certificates/private.pem is only readable by {{ secretweb_user }} (mode
# 600), so this always runs secretweb_client.py as that user - via sudo
# when invoked as anyone else, direct otherwise (skipping sudo when
# already {{ secretweb_user }} avoids requiring a sudoers rule just to
# run as yourself, e.g. from a script already running as that user).
# {{ secretweb_user }}'s shell is /usr/sbin/nologin, but that only breaks
# `-i`/login-shell invocations (see howto.txt) - a plain `sudo -u` exec's
# the interpreter directly, same as this script does in the other branch.
SECRETWEB_USER="{{ secretweb_user }}"
INSTALL_DIR="{{ secretweb_install_dir }}"

if [ "$(id -un)" = "$SECRETWEB_USER" ]; then
    exec "$INSTALL_DIR/venv/bin/python3" "$INSTALL_DIR/secretweb_client.py" "$@"
else
    exec sudo -u "$SECRETWEB_USER" "$INSTALL_DIR/venv/bin/python3" "$INSTALL_DIR/secretweb_client.py" "$@"
fi
